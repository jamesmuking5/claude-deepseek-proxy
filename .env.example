# DeepSeek API Key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Google Gemini API Key (https://aistudio.google.com/apikey — free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenCode API Key (https://opencode.ai)
OPENCODE_API_KEY=your_opencode_api_key_here

# Z.AI API Key (https://z.ai — optional, enables GLM-5.2 via claude-opus-4-8)
ZAI_API_KEY=your_zai_api_key_here

# xAI API Key (https://console.x.ai — optional, enables Grok 4.5 via claude-opus-4-9)
XAI_API_KEY=your_xai_api_key_here
XAI_REASONING_EFFORT=low

# Reasoning/thinking is always enabled. Set THINKING=false to force minimal
# reasoning effort on providers that support the control (e.g. xAI).
# THINKING=false

# Generic OpenAI-compatible backend (optional — enables any /v1/chat/completions provider)
# All three OPENAI_COMPAT_* vars (key, base URL, model map) must be set to enable this provider.
# Capability flags below default to false; set to "true" only if your provider supports the feature.
# OPENAI_COMPAT_API_KEY=your_api_key_here
# OPENAI_COMPAT_BASE_URL=https://your-provider.example/v1
# OPENAI_COMPAT_MODEL_MAP={"claude-sonnet-4-6":"provider-model-id"}
# OPENAI_COMPAT_TOOLS=false
# OPENAI_COMPAT_PARALLEL_TOOLS=false
# OPENAI_COMPAT_VISION=false
# OPENAI_COMPAT_REASONING=false
# OPENAI_COMPAT_STREAM_USAGE=false
